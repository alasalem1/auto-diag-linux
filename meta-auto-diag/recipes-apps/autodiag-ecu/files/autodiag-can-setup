#!/bin/sh
set -eu

echo "AutoDiag: preparing CAN environment"

# Load required kernel modules
/usr/sbin/modprobe vcan
/usr/sbin/modprobe can-isotp

# Create vcan0 only if it does not already exist
if ! /usr/sbin/ip link show vcan0 >/dev/null 2>&1; then
    /usr/sbin/ip link add dev vcan0 type vcan
fi

# Ensure the interface is active
/usr/sbin/ip link set dev vcan0 up

echo "AutoDiag: vcan0 is ready"
